# Generate with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('choose-a-password'))"
APP_PASSWORD_HASH=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-random-value
# Direct homelab HTTP requires false. Change to true when serving through HTTPS.
SECURE_COOKIES=false
MAX_UPLOAD_MB=10
OBSIDIAN_VAULT=Remulous Labs
CRM_DATA_DIR=/data
# Bind on the Docker server's network interfaces so other homelab devices can connect.
# Set this to the Docker server's LAN IP to restrict the listener to that interface.
CRM_BIND_ADDRESS=0.0.0.0
CRM_PORT=8000
